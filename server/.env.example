# Copy to `.env` and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL=postgresql://itsm:itsm_password@localhost:5432/itsm

# Secret used to sign session tokens. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN_HOURS=12

# Origin of the web client (used for CORS and Socket.io)
CLIENT_ORIGIN=http://localhost:5173

# Ticket auto-assignment default: LEAST_ACTIVE or ROUND_ROBIN
ASSIGNMENT_STRATEGY=LEAST_ACTIVE

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Password given to every demo account created by `npm run db:seed`
SEED_PASSWORD=ChangeMe123!
